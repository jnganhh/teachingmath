rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Teacher signs in on teacher-dashboard.html with Google (non-anonymous).
    // Add the teacher's email as a document ID under /teachers/{email} in Firebase Console.
    function isTeacher() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/teachers/$(request.auth.token.email));
    }

    function validStudentSummary(data) {
      return data.keys().hasOnly([
          'ownerUid', 'name', 'cls', 'course', 'practiceType', 'lastMode',
          'modesPracticed', 'totalCorrect', 'totalAttempts', 'bestStreak',
          'activeMin', 'levelled', 'skills', 'lastReason', 'updatedAt'
        ])
        && data.ownerUid == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.cls is string && data.cls.size() >= 1 && data.cls.size() <= 40
        && data.totalCorrect is int && data.totalCorrect >= 0
        && data.totalAttempts is int && data.totalAttempts >= data.totalCorrect
        && data.bestStreak is int && data.bestStreak >= 0
        && data.activeMin is int && data.activeMin >= 0
        && data.updatedAt == request.time;
    }

    // Students use silent Anonymous Auth (zero login prompt, no school Google account needed).
    // Students can only write their own document and cannot read/list other students' data.
    match /mpm2d_students/{docId} {
      allow get: if isTeacher() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow list: if isTeacher();
      allow create: if signedIn() && validStudentSummary(request.resource.data);
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && validStudentSummary(request.resource.data);
      allow delete: if false;
    }

    match /teachers/{email} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
